{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "stardust-omew",
  "account_id": "20c1630f373f1d9663f96f153d4a3194",
  "main": "src/api.ts",
  "compatibility_date": "2026-08-21",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "durable_objects": {
    "bindings": [
      { "name": "ROOM_DO", "class_name": "RoomDO" },
      { "name": "STRONGHOLD_DO", "class_name": "StrongholdDO" }
    ]
  },
  "exports": {
    "RoomDO": { "type": "durable-object", "storage": "sqlite" },
    "StrongholdDO": { "type": "durable-object", "storage": "sqlite" }
  },
  "vars": {
    "INSTANCE_DOMAIN": "omew.stardustinfinity.top",
    "CF_WORKER_NAME": "stardust-omew",
    "INSTANCE_MODE": "single",
    "ROOT_STRONGHOLD": "medium5",
    "SSO_MODE": "required",
    "SSO_ISSUER": "https://stardustinfinity.top",
    "SSO_CLIENT_ID": "stardust-omew",
    "SSO_PROVIDER_NAME": "星尘粉丝站",
    "SSO_USE_PAR": "1",
    "SSO_USE_JARM": "0",
    "SSO_USE_DPOP": "0",
    "ALLOW_ROOT": "0",
    "ROOT_REQUIREMENTS": "",
    "TRUSTED_IDENTITY_SERVERS": "*",
    "FEDERATION_PEERS": "",
    "STRONGHOLD_CREATION": "restricted",
    "STRONGHOLD_CREATORS": "",
    "INSTANCE_LOGO_URL": "https://stardustinfinity.top/favicon.svg",
    "ENABLE_EMOTES": "1",
    "USE_BUILTIN_EMOTES": "1",
    "ENABLE_REACTIONS": "1",
    "USE_ART_ASSETS": "0",
    "ALLOW_GUEST_BROWSING": "1",
    "MAX_FILE_BYTES": "10485760",
    "USER_STORAGE_QUOTA_BYTES": "209715200"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "stardust-omew",
      "database_id": "1f9c6383-4b90-4488-918a-10a9673f54d8",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "stardust-omew-media" }
  ],
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/federation/*", "/stronghold", "/stronghold/*", "/inbox", "/inbox/*", "/media/*"]
  },
  "routes": [
    { "pattern": "omew.stardustinfinity.top", "custom_domain": true }
  ]
}
