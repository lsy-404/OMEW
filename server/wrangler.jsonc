{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "openmew-server",
  // this login has several accounts; without this, any non-interactive
  // deploy or --remote d1 command aborts on "More than one account available".
  "account_id": "df4481f3ce1fa0394b4617442a97d147",
  "main": "src/api.ts",
  "compatibility_date": "2026-08-21",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOM_DO", "class_name": "RoomDO" },
      { "name": "STRONGHOLD_DO", "class_name": "StrongholdDO" }
    ]
  },
  "exports": {
    "RoomDO": { "type": "durable-object", "storage": "sqlite" },
    "StrongholdDO": { "type": "durable-object", "storage": "sqlite" }
  },
  "vars": {
    "INSTANCE_DOMAIN": "omew.wuyilingwei.com",
    "CF_WORKER_NAME": "openmew-server",
    // m0-protocol §7.9: instance policy as deployment env config - see
    // server/src/config.ts for parsing and .dev.vars.example for local overrides.
    "ALLOW_ROOT": "1",
    "ROOT_REQUIREMENTS": "",
    "TRUSTED_IDENTITY_SERVERS": "*",
    "FEDERATION_PEERS": "",
    "STRONGHOLD_CREATION": "restricted",
    "STRONGHOLD_CREATORS": "",
    "ALLOW_GUEST_BROWSING": "1",
    "MAX_FILE_BYTES": "10485760",
    "USER_STORAGE_QUOTA_BYTES": "209715200"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "openmew",
      "database_id": "6ec2421a-2a72-46d6-acd2-f6356b738772",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "omew-media" }
  ],
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    // every worker-served prefix must be listed here: anything missing is
    // swallowed by the SPA fallback above and comes back as index.html.
    // Keep in sync with web/vite.config.ts's dev proxy.
    "run_worker_first": ["/api/*", "/federation/*", "/stronghold", "/stronghold/*", "/inbox", "/inbox/*", "/media/*"]
  },
  "routes": [
    { "pattern": "omew.wuyilingwei.com", "custom_domain": true }
  ]
}
